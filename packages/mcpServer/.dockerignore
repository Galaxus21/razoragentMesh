# The build context for mcp-server IS this package directory (docker-compose.yml sets
# context: ./packages/mcpServer), so this file is live.
#
# Patterns anchor at the context root: nested matches need a leading **/ .

# Secrets: the builder stage does COPY . . , so an env file here would land in a layer.
**/.env
**/.env.*

# Dependencies and build output -- npm ci and tsc regenerate both inside the image.
**/node_modules
**/dist

# Tests. tsconfig.json already excludes test/ from the compile, so this is pure context weight.
**/test
**/*.test.ts

# Docker, VCS, logs and OS noise
Dockerfile
.dockerignore
**/.git
**/.gitignore
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
