{
  "name": "razoragent-mesh-telemetry-dashboard",
  "version": "2.0.0",
  "description": "Layer 5 Real-Time Telemetry Dashboard for RazorAgent Mesh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "docs:manifest": "tsx scripts/generateDocsManifest.ts",
    "docs:search": "tsx scripts/generateDocsSearchIndex.ts",
    "docs:reference": "tsx scripts/generateSdkReference.ts",
    "docs:verify": "tsx scripts/verifyDocSnippets.ts",
    "docs:generate": "npm run docs:manifest && npm run docs:search && npm run docs:reference && npm run docs:examples",
    "docs:examples": "tsx scripts/generateExampleSnippets.ts"
  },
  "dependencies": {
    "@razorpay/agent-buyer-sdk": "file:../buyerSdkTs",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
