# ==============================================================================
# RAZORAGENT MESH — ENVIRONMENT CONFIGURATION TEMPLATE
# ALL variables below have built-in defaults. The mesh runs 100% out of the box
# even with an empty or absent .env file (using localhost services & mock ledger).
# Only add keys you wish to override (e.g. real Razorpay test keys or custom URLs).
# ==============================================================================

# --- 1. Razorpay Test Credentials (Track 01) ---
# [OPTIONAL] Real keys record authentic test orders (POST /v1/orders); placeholders or blank run on mock ledger.
RAZORPAY_KEY_ID=rzp_test_MockApiKey12345
RAZORPAY_KEY_SECRET=MockApiSecretKey67890

# [OPTIONAL] Enable live Route transfers & capture (default: false; requires active linked accounts)
RAZORPAY_ROUTE_LIVE=false

# [OPTIONAL] Inbound webhook secret for HMAC-SHA256 signature verification (from Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=

# --- 2. Infrastructure Data Stores ---
# [OPTIONAL] Redis connection URL (default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# [OPTIONAL] Qdrant vector DB host and ports for Layer 3 semantic search & self-healing (default: localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# --- 3. Cryptographic Signing Keys ---
# [OPTIONAL] Merchant Ed25519 private key hex seed. Leave empty to use committed dev key with warning.
# Generate new keypair: python scripts/generateTestKeys.py
MERCHANT_PRIVATE_KEY_HEX=

# [OPTIONAL] HMAC secret key for quote hashing. Must match across services. Leave empty for dev key.
HMAC_SECRET_KEY=

# --- 4. Inter-Service Mesh URLs & Ports ---
# [OPTIONAL] Defaults to localhost ports (8000, 4001, 4002, 4003)
MANDATE_ENGINE_URL=http://localhost:8000
MCP_SERVER_URL=http://localhost:4001
MERCHANT_API_URL=http://localhost:4002
X402_GATEWAY_URL=http://localhost:4003

# [OPTIONAL] HTTP REST adapter port for MCP server (default: 4001)
PORT=4001

# --- 5. Telemetry & Dashboard (Layer 5) ---
# [OPTIONAL] SSE stream URL for real-time telemetry events (default: http://localhost:8000/api/v1/telemetry/stream)
NEXT_PUBLIC_TELEMETRY_SSE_URL=http://localhost:8000/api/v1/telemetry/stream

# [OPTIONAL] Git branch for dashboard "view source" links (default: main)
# DOCS_SOURCE_BRANCH=main

# [OPTIONAL] Telemetry Dashboard URL used by simulation scripts (default: http://localhost:3000)
DASHBOARD_URL=http://localhost:3000

# --- 6. Feature Flags & Test Seams ---
# [OPTIONAL] MCP transport mode: stdio | http | both (default: both)
# MCP_TRANSPORT=both

# [OPTIONAL] Clock test override for settlement engine (default: false; NEVER enable in production)
# ALLOW_CLIENT_SERVER_TIME=false

# [OPTIONAL] Allow http://localhost for price-drop webhooks (default: false; local testing only)
# ALLOW_LOCALHOST_CALLBACK=false


