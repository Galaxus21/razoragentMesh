# Layer 5 Telemetry SSE Endpoint
NEXT_PUBLIC_TELEMETRY_SSE_URL=http://localhost:8000/api/v1/telemetry/stream

# Layer 2 Price-Drop Webhook SSRF Guard
# Agent-supplied callbackUrl values must be HTTPS with a public host. Private,
# loopback, link-local and reserved addresses (including the 169.254.169.254
# cloud metadata endpoint) are always rejected.
# Set to "true" ONLY for local demos, to additionally permit http://localhost
# callbacks. Leave unset/false in every deployed environment.
# ALLOW_LOCALHOST_CALLBACK=false
